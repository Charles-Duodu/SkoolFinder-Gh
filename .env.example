# ==============================================================================
# SkoolFinder Ghana - Fullstack Next.js SaaS Environment Variables
# Copy this file to .env.local and fill in your live credentials.
# ==============================================================================

# 1. Supabase Auth, PostgreSQL & File Storage (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Resend Transactional Email Management (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SkoolFinder Ghana <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=support@skoolfinder.com.gh

# 3. Application URL & Optional Demo Bar Toggle
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_BAR=true

# 4. Bachs Payment & Billing Platform (https://bachs.io)
BACHS_SECRET_KEY=
BACHS_PUBLIC_KEY=
BACHS_WEBHOOK_SECRET=
NEXT_PUBLIC_BACHS_ENVIRONMENT=sandbox

# 5. Ghana SMS Gateway (Arkesel / Hubtel)
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=SkoolFinder
